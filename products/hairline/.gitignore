.venv/
__pycache__/
# `out/` is where `hairline measure` writes a local run. That is scratch.
/out/

# The evaluation and benchmark output are evidence, not build litter. docs/evaluation.md
# and docs/cool-benchmark.md cite them row by row, and a judge should be able to
# recompute any figure from them without an AWS account. Only the rendered refusal
# frames are left out, and they regenerate in seconds.
!eval/out/
eval/out/frames/
!bench/out/
.pytest_cache/

# The sample clips are deliberately committed: the deployed endpoint has to work
# from a cold start with nothing uploaded, and a judge should be able to reproduce
# the demo from the repo alone. The root .gitignore excludes *.mp4 for model and
# footage artefacts; these four files are the exception, and they are 12 MB total.
!src/hairline/samples/walk-past.mp4
